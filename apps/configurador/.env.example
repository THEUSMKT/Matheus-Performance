# Variáveis públicas do build (entram no HTML — nunca coloque segredos aqui).
# No GitHub Pages, cadastre como "Variables" do repositório; o workflow as repassa.

# Caminho de publicação. O workflow já define.
NEXT_PUBLIC_BASE_PATH=/Matheus-Performance/configurador

# 'production' só no build publicado. Qualquer outro valor = teste (sempre noindex).
NEXT_PUBLIC_SITE_ENV=development

# URL do receptor de pedidos. Vazia = modo WhatsApp (nenhum pedido é dado como recebido).
# Repositório: variável LEAD_ENDPOINT.
NEXT_PUBLIC_LEAD_ENDPOINT=

# Prazo de retorno exibido após um pedido confirmado, ex.: "em até 1 dia útil".
# Deixe vazio até existir um prazo real combinado. Repositório: RESPONSE_EXPECTATION.
NEXT_PUBLIC_RESPONSE_EXPECTATION=

# ── Só no ambiente do receptor (função serverless), nunca no build da página ──
# LEAD_ALLOWED_ORIGIN=https://theusmkt.github.io
# CRM_API_TOKEN=            # token do CRM escolhido
# LEAD_STORE_URL=           # banco/planilha/KV onde o pedido é salvo antes da resposta
